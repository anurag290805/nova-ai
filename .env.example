# Copy to .env.local for local development. No cloud credentials are used.
# The provider rejects non-localhost URLs to prevent cloud routing.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default local baseline. Replace with qwen3:1.7b for the CP02 comparison.
OLLAMA_MODEL=llama3.2:1b
# Qwen3 supports the Ollama chat API's top-level think flag. Leave false for
# bounded CPU evaluation; set true only when intentionally evaluating thinking.
OLLAMA_THINK=false
# Bound local Qwen3 responses to keep CPU-only tool loops observable. Omit to
# use NOVA's Qwen3 default of 256; set a value from 16 through 4096 to override.
OLLAMA_NUM_PREDICT=256
OLLAMA_TIMEOUT_MS=120000
# Overall deadline across planning, model turns, and tools (5,000–600,000 ms).
AGENT_DEADLINE_MS=180000
